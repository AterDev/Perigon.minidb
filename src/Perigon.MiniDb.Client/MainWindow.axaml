<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:Perigon.MiniDb.Client.ViewModels"
        x:Name="RootWindow"
        x:Class="Perigon.MiniDb.Client.MainWindow"
        x:DataType="vm:MainViewModelV2"
        mc:Ignorable="d"
        Title="{Binding [App.Title]}"
        Icon="avares://Perigon.MiniDb.Client/Resources/perigon_icon.png"
        SystemDecorations="None"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        Width="1300"
        Height="760"
        MinWidth="1180"
        MinHeight="680">

  <Window.Styles>
    <Style Selector="Border.titleBarHost">
      <Setter Property="Background" Value="{DynamicResource ThemeControlMidBrush}" />
      <Setter Property="CornerRadius" Value="10,10,0,0" />
      <Setter Property="Height" Value="32" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="Menu.titleMenu">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="Menu.titleMenu > MenuItem" >
      <Setter Property="MinHeight" Value="32" />
      <Setter Property="Padding" Value="10,0,10,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.captionBtn">
      <Setter Property="Width" Value="48" />
      <Setter Property="Height" Value="32" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
      <Setter Property="FontSize" Value="10" />
    </Style>
    <Style Selector="Button.captionBtn:pointerover">
      <Setter Property="Background" Value="{DynamicResource ThemeControlHighBrush}" />
    </Style>
    <Style Selector="Button.captionBtn:pressed">
      <Setter Property="Background" Value="{DynamicResource ThemeControlLowBrush}" />
    </Style>
    <Style Selector="Button.closeBtn:pointerover">
      <Setter Property="Background" Value="#E81123" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Border.card">
      <Setter Property="Padding" Value="4" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Background" Value="{DynamicResource ThemeControlMidBrush}" />
    </Style>
    <Style Selector="TextBlock.sectionTitle">
      <Setter Property="FontSize" Value="16" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.metaText">
      <Setter Property="Opacity" Value="0.78" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="Border.badge">
      <Setter Property="CornerRadius" Value="999" />
      <Setter Property="Padding" Value="8,3" />
      <Setter Property="Background" Value="{DynamicResource ThemeAccentBrush2}" />
    </Style>
    <Style Selector="Border.chip">
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="8,4" />
      <Setter Property="Margin" Value="0,0,8,8" />
      <Setter Property="Background" Value="{DynamicResource ThemeAccentBrush2}" />
    </Style>
    <Style Selector="Border.statusBar">
      <Setter Property="Background" Value="{DynamicResource ThemeAccentBrush2}" />
    </Style>
    <Style Selector="Border.statusBar.error">
      <Setter Property="Background" Value="#A32222" />
    </Style>
    <Style Selector="Border.statusBar.warn">
      <Setter Property="Background" Value="#B57300" />
    </Style>
    <Style Selector="Border.statusBar.success">
      <Setter Property="Background" Value="#1E7A39" />
    </Style>
  </Window.Styles>

  <Design.DataContext>
    <vm:MainViewModelV2 />
  </Design.DataContext>

  <Grid RowDefinitions="Auto,*,Auto" Margin="4">
    <Border Grid.Row="0" Classes="titleBarHost" Margin="0,0,0,4">
      <Grid ColumnDefinitions="Auto,Auto,*,Auto">
        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,2,0" Spacing="4">
          <Image Width="18"
                 Height="18"
                 Stretch="Uniform"
                 Source="avares://Perigon.MiniDb.Client/Resources/perigon_icon.png" />
          <TextBlock Text="Perigon MiniDb" FontWeight="SemiBold" VerticalAlignment="Center" />
        </StackPanel>

        <Menu Grid.Column="1" Classes="titleMenu" VerticalAlignment="Center" Margin="2,0,0,0">
          <MenuItem Header="{Binding MenuConnectionText}">
            <MenuItem Header="{Binding MenuManageConnectionsText}" Click="OpenConnectionManager_Click" />
            <Separator />
            <MenuItem Header="{Binding [Button.Connect]}" Command="{Binding ConnectCommand}" />
            <MenuItem Header="{Binding [Button.Disconnect]}" Command="{Binding DisconnectCommand}" />
          </MenuItem>
          <MenuItem Header="{Binding MenuAppearanceText}">
            <MenuItem Header="{Binding MenuLightThemeText}" Click="UseLightTheme_Click" />
            <MenuItem Header="{Binding MenuDarkThemeText}" Click="UseDarkTheme_Click" />
            <MenuItem Header="{Binding MenuSystemThemeText}" Click="UseSystemTheme_Click" />
          </MenuItem>
          <MenuItem Header="{Binding MenuLanguageText}">
            <MenuItem Header="中文" ToggleType="CheckBox" IsChecked="{Binding IsChinese}" Click="SwitchToChinese_Click" />
            <MenuItem Header="English" ToggleType="CheckBox" IsChecked="{Binding IsEnglish}" Click="SwitchToEnglish_Click" />
          </MenuItem>
          <MenuItem Header="{Binding MenuHelpText}">
            <MenuItem Header="{Binding MenuOpenRepoText}" Click="OpenRepository_Click" />
            <MenuItem Header="{Binding MenuOpenIssuesText}" Click="OpenIssues_Click" />
          </MenuItem>
        </Menu>

        <Border Grid.Column="2"
                Background="Transparent"
                PointerPressed="TitleBarDragRegion_PointerPressed"
                DoubleTapped="TitleBarDragRegion_DoubleTapped" />

        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
          <Button Classes="captionBtn" Content="&#xE921;" Click="MinimizeWindow_Click" />
          <Button x:Name="MaxRestoreButton" Classes="captionBtn" Content="&#xE922;" Click="ToggleMaximizeRestore_Click" />
          <Button Classes="captionBtn closeBtn" Content="&#xE8BB;" Click="CloseWindow_Click" />
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="1" Margin="0,2,0,4" ColumnDefinitions="280,4,*">
      <Border Grid.Column="0" Classes="card">
        <Grid RowDefinitions="Auto,Auto,Auto,*">
          <TextBlock Classes="sectionTitle" Text="{Binding [Section.Tables]}" />
          <TextBlock Grid.Row="1" Margin="0,2,0,4" Classes="metaText" Text="{Binding LabelTableCount}" />
          <TextBox Grid.Row="2" Watermark="{Binding [Label.SearchTableWatermark]}" Text="{Binding TableSearchText}" />
          <ListBox Grid.Row="3"
                   Margin="0,4,0,0"
                   ItemsSource="{Binding TableNames}"
                   SelectedItem="{Binding SelectedTableName}" />
        </Grid>
      </Border>

      <Border Grid.Column="2" Classes="card">
        <Grid>
          <Grid RowDefinitions="Auto,Auto,*,Auto" IsVisible="{Binding IsConnected}">
            <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="4">
              <TextBlock Grid.Column="0" Classes="sectionTitle" Text="{Binding TableTitle}" />
              <Border Grid.Column="1" Classes="badge" VerticalAlignment="Center">
                <TextBlock Text="{Binding LabelFilteredCount}" />
              </Border>
              <TextBlock Grid.Column="2" HorizontalAlignment="Right" Classes="metaText" Text="{Binding LabelRawCount}" />
            </Grid>

            <Grid Grid.Row="1" Margin="0,4,0,4" ColumnDefinitions="200,*,Auto,Auto">
              <ComboBox Grid.Column="0" ItemsSource="{Binding FilterFields}" SelectedItem="{Binding SelectedFilterField}" />
              <TextBox Grid.Column="1" Margin="4,0,0,0" Watermark="{Binding [Label.FilterWatermark]}" Text="{Binding FilterValue}" />
              <Button Grid.Column="2" Margin="4,0,0,0" Content="{Binding [Button.Apply]}" Command="{Binding ApplyFilterCommand}" />
              <Button Grid.Column="3" Margin="4,0,0,0" Content="{Binding [Button.Clear]}" Command="{Binding ClearFilterCommand}" />
            </Grid>

            <Grid Grid.Row="2">
              <DataGrid IsReadOnly="True"
                        CanUserResizeColumns="True"
                        CanUserSortColumns="True"
                        MaxColumnWidth="420"
                        MinColumnWidth="80"
                        ColumnWidth="Auto"
                        AutoGenerateColumns="False"
                        ItemsSource="{Binding PagedRecords}">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="Id" Binding="{Binding Id}" Width="100" />
                  <DataGridCheckBoxColumn Header="IsDeleted" Binding="{Binding IsDeleted}" Width="120" />
                  <DataGridTextColumn Header="PayloadUtf8Preview" Binding="{Binding PayloadUtf8Preview}" Width="*" />
                  <DataGridTextColumn Header="PayloadHex" Binding="{Binding PayloadHex}" Width="2*" />
                </DataGrid.Columns>
              </DataGrid>

              <Border IsVisible="{Binding HasNoData}" CornerRadius="8" Background="{DynamicResource ThemeControlLowBrush}" Padding="12" Margin="4">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="6">
                  <TextBlock Text="{Binding [Label.NoDataTitle]}" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" />
                  <TextBlock Text="{Binding EmptyStateMessage}" Classes="metaText" HorizontalAlignment="Center" />
                </StackPanel>
              </Border>
            </Grid>

            <Grid Grid.Row="3" Margin="0,4,0,0" ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,12,Auto,*">
              <Button Grid.Column="0" Content="{Binding [Button.FirstPage]}" Command="{Binding FirstPageCommand}" />
              <Button Grid.Column="1" Margin="4,0,0,0" Content="{Binding [Button.PrevPage]}" Command="{Binding PreviousPageCommand}" />
              <Button Grid.Column="2" Margin="4,0,0,0" Content="{Binding [Button.NextPage]}" Command="{Binding NextPageCommand}" />
              <Button Grid.Column="3" Margin="4,0,0,0" Content="{Binding [Button.LastPage]}" Command="{Binding LastPageCommand}" />
              <ComboBox Grid.Column="4" Margin="4,0,0,0" Width="90" SelectedItem="{Binding PageSize}" ItemsSource="{Binding PageSizeOptions}" />

              <TextBlock Grid.Column="6"
                         VerticalAlignment="Center"
                         Text="{Binding PageSummary}" />

              <TextBlock Grid.Column="7"
                         Margin="4,0,0,0"
                         HorizontalAlignment="Right"
                         VerticalAlignment="Center"
                         Classes="metaText"
                         Text="{Binding FilterSummary}" />
            </Grid>
          </Grid>

          <Border IsVisible="{Binding IsDisconnected}" CornerRadius="8" Background="{DynamicResource ThemeControlLowBrush}" Padding="12" Margin="4">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="6">
              <TextBlock Text="{Binding [Label.NoConnection]}" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" />
              <TextBlock Text="{Binding SelectedConnectionPathDisplay}" Classes="metaText" HorizontalAlignment="Center" />
            </StackPanel>
          </Border>
        </Grid>
      </Border>
    </Grid>

    <Border Grid.Row="2"
            Classes="statusBar"
            Classes.error="{Binding IsStatusError}"
            Classes.warn="{Binding IsStatusWarning}"
            Classes.success="{Binding IsStatusSuccess}"
            Padding="4"
            CornerRadius="6">
      <TextBlock Text="{Binding StatusMessage}" />
    </Border>

  </Grid>
</Window>
