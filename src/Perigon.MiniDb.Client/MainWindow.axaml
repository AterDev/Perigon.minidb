<Window xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:vm="using:Perigon.MiniDb.Client.ViewModels"
  x:Name="RootWindow"
  x:Class="Perigon.MiniDb.Client.MainWindow"
  x:DataType="vm:MainViewModel"
  mc:Ignorable="d"
  Title="{Binding AppTitle}"
  SystemDecorations="None"
  ExtendClientAreaToDecorationsHint="True"
  ExtendClientAreaChromeHints="NoChrome"
  Width="1300"
  Height="760"
  MinWidth="1180"
  MinHeight="680">

  <Window.Styles>
    <Style Selector="Border.titleBarHost">
      <Setter Property="Background" Value="{DynamicResource ThemeControlMidBrush}" />
      <Setter Property="CornerRadius" Value="10,10,0,0" />
      <Setter Property="Height" Value="32" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="Menu.titleMenu">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="Menu.titleMenu > MenuItem">
      <Setter Property="MinHeight" Value="32" />
      <Setter Property="Padding" Value="10,0,10,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.captionBtn">
      <Setter Property="Width" Value="48" />
      <Setter Property="Height" Value="32" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
      <Setter Property="FontSize" Value="10" />
    </Style>
    <Style Selector="Button.captionBtn:pointerover">
      <Setter Property="Background" Value="{DynamicResource ThemeControlHighBrush}" />
    </Style>
    <Style Selector="Button.captionBtn:pressed">
      <Setter Property="Background" Value="{DynamicResource ThemeControlLowBrush}" />
    </Style>
    <Style Selector="Button.closeBtn:pointerover">
      <Setter Property="Background" Value="#E81123" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Border.card">
      <Setter Property="Padding" Value="4" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Background" Value="{DynamicResource ThemeControlMidBrush}" />
    </Style>
    <Style Selector="TextBlock.sectionTitle">
      <Setter Property="FontSize" Value="16" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.metaText">
      <Setter Property="Opacity" Value="0.78" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="Border.badge">
      <Setter Property="CornerRadius" Value="999" />
      <Setter Property="Padding" Value="8,3" />
      <Setter Property="Background" Value="{DynamicResource ThemeAccentBrush2}" />
    </Style>
    <Style Selector="Border.chip">
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="8,4" />
      <Setter Property="Margin" Value="0,0,8,8" />
      <Setter Property="Background" Value="{DynamicResource ThemeAccentBrush2}" />
    </Style>
    <Style Selector="Border.statusBar">
      <Setter Property="Background" Value="{DynamicResource ThemeAccentBrush2}" />
    </Style>
    <Style Selector="Border.statusBar.error">
      <Setter Property="Background" Value="#A32222" />
    </Style>
    <Style Selector="Border.statusBar.warn">
      <Setter Property="Background" Value="#B57300" />
    </Style>
    <Style Selector="Border.statusBar.success">
      <Setter Property="Background" Value="#1E7A39" />
    </Style>
  </Window.Styles>

  <Design.DataContext>
    <vm:MainViewModel />
  </Design.DataContext>

  <Grid RowDefinitions="Auto,*,Auto" Margin="4">
    <Border Grid.Row="0" Classes="titleBarHost" Margin="0,0,0,4">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <Menu Grid.Column="0" Classes="titleMenu" VerticalAlignment="Center" Margin="2,0,0,0">
          <MenuItem Header="{Binding MenuConnection}">
            <MenuItem Header="{Binding MenuManageConnections}" Click="OpenConnectionManager_Click" />
            <Separator />
            <MenuItem Header="{Binding BtnConnect}" Command="{Binding ConnectCommand}" />
            <MenuItem Header="{Binding BtnDisconnect}" Command="{Binding DisconnectCommand}" />
            <MenuItem Header="{Binding BtnCreateSample}" Click="CreateSampleDatabase_Click" />
          </MenuItem>
          <MenuItem Header="{Binding MenuAppearance}">
            <MenuItem Header="{Binding MenuLightTheme}" Click="UseLightTheme_Click" />
            <MenuItem Header="{Binding MenuDarkTheme}" Click="UseDarkTheme_Click" />
            <MenuItem Header="{Binding MenuSystemTheme}" Click="UseSystemTheme_Click" />
            <Separator />
            <MenuItem Header="{Binding MenuToggleGlass}" ToggleType="CheckBox" IsChecked="{Binding IsGlassEffectEnabled}" />
            <MenuItem Header="{Binding BtnResetView}" Click="ResetViewPreferences_Click" />
          </MenuItem>
          <MenuItem Header="{Binding MenuLanguage}">
            <MenuItem Header="{Binding MenuLangZh}" ToggleType="CheckBox" IsChecked="{Binding IsChinese}" Click="SwitchToChinese_Click" />
            <MenuItem Header="{Binding MenuLangEn}" ToggleType="CheckBox" IsChecked="{Binding IsEnglish}" Click="SwitchToEnglish_Click" />
          </MenuItem>
          <MenuItem Header="{Binding MenuHelp}">
            <MenuItem Header="{Binding MenuOpenRepo}" Click="OpenRepository_Click" />
            <MenuItem Header="{Binding MenuOpenIssues}" Click="OpenIssues_Click" />
          </MenuItem>
        </Menu>

        <Border Grid.Column="1"
                Background="Transparent"
                PointerPressed="TitleBarDragRegion_PointerPressed"
                DoubleTapped="TitleBarDragRegion_DoubleTapped" />

        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
          <Button Classes="captionBtn" Content="&#xE921;" Click="MinimizeWindow_Click" />
          <Button x:Name="MaxRestoreButton" Classes="captionBtn" Content="&#xE922;" Click="ToggleMaximizeRestore_Click" />
          <Button Classes="captionBtn closeBtn" Content="&#xE8BB;" Click="CloseWindow_Click" />
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="1" Margin="0,2,0,4" ColumnDefinitions="280,4,*">
      <Border Grid.Column="0" Classes="card">
        <Grid RowDefinitions="Auto,Auto,Auto,*">
          <TextBlock Classes="sectionTitle" Text="{Binding SectionTables}" />
          <TextBlock Grid.Row="1" Margin="0,2,0,4" Classes="metaText" Text="{Binding LabelTableCount}" />
          <TextBox Grid.Row="2" Watermark="{Binding LabelSearchTableWatermark}" Text="{Binding TableSearchText}" />
          <ListBox Grid.Row="3"
                   Margin="0,4,0,0"
                   ItemsSource="{Binding TableNames}"
                   SelectedItem="{Binding SelectedTableName}" />
        </Grid>
      </Border>

      <Border Grid.Column="2" Classes="card">
        <Grid>
          <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" IsVisible="{Binding IsConnected}">
          <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="4">
            <TextBlock Grid.Column="0" Classes="sectionTitle" Text="{Binding TableTitle}" />
            <Border Grid.Column="1" Classes="badge" VerticalAlignment="Center">
              <TextBlock Text="{Binding LabelFilteredCount}" />
            </Border>
            <TextBlock Grid.Column="2" HorizontalAlignment="Right" Classes="metaText" Text="{Binding LabelRawCount}" />
          </Grid>

          <Grid Grid.Row="1" Margin="0,4,0,4" ColumnDefinitions="180,120,*,*,Auto,Auto,Auto,Auto">
            <ComboBox Grid.Column="0" ItemsSource="{Binding FilterFields}" SelectedItem="{Binding SelectedFilterField}" />
            <ComboBox Grid.Column="1" Margin="4,0,0,0" ItemsSource="{Binding FilterOperators}" SelectedItem="{Binding SelectedFilterOperatorOption}" />
            <TextBox Grid.Column="2" Margin="4,0,0,0" Watermark="{Binding LabelFilterValueWatermark}" Text="{Binding FilterValue}" />
            <TextBox Grid.Column="3" Margin="4,0,0,0" Watermark="{Binding LabelFilterValueToWatermark}" Text="{Binding FilterValueTo}" />
            <Button Grid.Column="4" Margin="4,0,0,0" Content="{Binding BtnAddCondition}" Command="{Binding AddFilterConditionCommand}" />
            <Button Grid.Column="5" Margin="4,0,0,0" Content="{Binding BtnRemoveCondition}" Command="{Binding RemoveFilterConditionCommand}" />
            <Button Grid.Column="6" Margin="4,0,0,0" Content="{Binding BtnApply}" Command="{Binding ApplyFilterCommand}" />
            <Button Grid.Column="7" Margin="4,0,0,0" Content="{Binding BtnClear}" Command="{Binding ClearFilterCommand}" />
          </Grid>

          <Grid Grid.Row="2" RowDefinitions="Auto,Auto" Margin="0,0,0,4">
            <TextBlock Text="{Binding ConditionSummary}" Opacity="0.85" />
            <ListBox Grid.Row="1"
                     Margin="0,4,0,0"
                     Height="82"
                     BorderThickness="0"
                     Background="Transparent"
                     ItemsSource="{Binding FilterConditions}"
                     SelectedItem="{Binding SelectedFilterCondition}">
              <ListBox.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel />
                  </ItemsPanelTemplate>
              </ListBox.ItemsPanel>
              <ListBox.ItemTemplate>
                  <DataTemplate>
                    <Border Classes="chip">
                      <TextBlock Text="{Binding DisplayText}" TextTrimming="CharacterEllipsis" MaxWidth="280" />
                    </Border>
                  </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Grid>

          <Grid Grid.Row="3">
            <DataGrid AutoGenerateColumns="True"
                      IsReadOnly="True"
                      CanUserSortColumns="True"
                      IsVisible="{Binding HasData}"
                      ItemsSource="{Binding PagedItems}" />
            <Border IsVisible="{Binding HasNoData}" CornerRadius="8" Background="{DynamicResource ThemeControlLowBrush}" Padding="12" Margin="4">
              <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="6">
                <TextBlock Text="{Binding LabelNoDataTitle}" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" />
                <TextBlock Text="{Binding EmptyStateMessage}" Classes="metaText" HorizontalAlignment="Center" />
              </StackPanel>
            </Border>
          </Grid>

          <Grid Grid.Row="4" Margin="0,4,0,0" ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,12,Auto,*">
            <Button Grid.Column="0" Content="{Binding BtnFirstPage}" Command="{Binding FirstPageCommand}" />
            <Button Grid.Column="1" Margin="4,0,0,0" Content="{Binding BtnPrevPage}" Command="{Binding PreviousPageCommand}" />
            <Button Grid.Column="2" Margin="4,0,0,0" Content="{Binding BtnNextPage}" Command="{Binding NextPageCommand}" />
            <Button Grid.Column="3" Margin="4,0,0,0" Content="{Binding BtnLastPage}" Command="{Binding LastPageCommand}" />
            <ComboBox Grid.Column="4" Margin="4,0,0,0" Width="90" SelectedItem="{Binding PageSize}" ItemsSource="{Binding PageSizeOptions}" />

            <TextBlock Grid.Column="6"
                       VerticalAlignment="Center"
                       Text="{Binding PageSummary}" />

            <TextBlock Grid.Column="7"
                       Margin="4,0,0,0"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center"
                       Classes="metaText"
                       Text="{Binding FilterSummary}" />
          </Grid>
          </Grid>

          <Border IsVisible="{Binding IsDisconnected}" CornerRadius="8" Background="{DynamicResource ThemeControlLowBrush}" Padding="12" Margin="4">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="6">
              <TextBlock Text="{Binding LabelNoConnection}" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" />
              <TextBlock Text="{Binding SelectedConnectionPathDisplay}" Classes="metaText" HorizontalAlignment="Center" />
            </StackPanel>
          </Border>
        </Grid>
      </Border>
    </Grid>

    <Border Grid.Row="2"
            Classes="statusBar"
            Classes.error="{Binding IsStatusError}"
            Classes.warn="{Binding IsStatusWarning}"
            Classes.success="{Binding IsStatusSuccess}"
            Padding="4"
            CornerRadius="6">
      <TextBlock Text="{Binding StatusMessage}" />
    </Border>
  </Grid>
</Window>
