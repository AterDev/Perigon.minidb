<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:Perigon.MiniDb.Client.ViewModels"
        x:Class="Perigon.MiniDb.Client.ConnectionManagerWindow"
        x:DataType="vm:MainViewModel"
        Width="900"
        Height="560"
        MinWidth="760"
        MinHeight="480"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource ThemeBackgroundBrush}"
        Title="{Binding MenuManageConnections}"
        mc:Ignorable="d">

  <Grid RowDefinitions="Auto,*,Auto" Margin="4">
    <StackPanel Spacing="4">
      <TextBlock Text="{Binding SectionConnectionConfig}" FontSize="18" FontWeight="SemiBold" />
      <TextBox Watermark="{Binding LabelSearchConnectionWatermark}" Text="{Binding ConnectionSearchText}" />
    </StackPanel>

    <Grid Grid.Row="1" Margin="0,4,0,4" ColumnDefinitions="320,4,*">
      <Border Background="{DynamicResource ThemeControlMidBrush}" CornerRadius="8" Padding="4">
        <ListBox ItemsSource="{Binding Connections}" SelectedItem="{Binding SelectedConnection}">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <StackPanel Spacing="2">
                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                <TextBlock Text="{Binding Path}" FontSize="12" Opacity="0.8" TextTrimming="CharacterEllipsis" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Border>

      <Border Grid.Column="2" Background="{DynamicResource ThemeControlMidBrush}" CornerRadius="8" Padding="4">
        <StackPanel Spacing="4">
          <TextBlock Text="{Binding SectionConnectionConfig}" FontWeight="SemiBold" FontSize="16" />
          <TextBox Watermark="{Binding LabelConnectionNameWatermark}" Text="{Binding NewConnectionName}" />
          <TextBox Watermark="{Binding LabelDbPathWatermark}" Text="{Binding NewConnectionPath}" />

          <StackPanel Orientation="Horizontal" Spacing="4">
            <Button Content="{Binding BtnBrowse}" Click="BrowseConnectionPath_Click" />
            <Button Content="{Binding BtnAdd}" Command="{Binding AddConnectionCommand}" />
            <Button Content="{Binding BtnUpdate}" Command="{Binding EditConnectionCommand}" />
            <Button Content="{Binding BtnDelete}" Command="{Binding DeleteConnectionCommand}" />
          </StackPanel>

          <TextBlock Text="{Binding SelectedConnectionPathDisplay}" Opacity="0.75" TextWrapping="Wrap" />
        </StackPanel>
      </Border>
    </Grid>

    <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="4">
      <TextBlock VerticalAlignment="Center" Text="{Binding StatusMessage}" />
      <Button Grid.Column="1" Content="{Binding BtnConnect}" Click="OpenSelectedConnection_Click" />
      <Button Grid.Column="2" Content="Close" Click="Close_Click" />
    </Grid>
  </Grid>
</Window>
